  m_Script: {fileID: 11500000, guid: 94a09b56ff894a8a9bbe6b36b0d8dd65, type: 3}
  m_Name: LoadingTipsData
  m_EditorClassIdentifier: Assembly-CSharp::TowerDefence.Data.LoadingTipsData
  tips:
  - 'Tip: Upgrade your towers to deal more damage!'
  - 'Tip: Place towers at choke points for maximum effectiveness.'
  - "Tip: Use spells wisely \u2014 they have long cooldowns."
  - 'Tip: Different tower types are strong against different enemies.'
  - 'Tip: Don''t forget to check the Skill Tree for permanent upgrades!'
  - 'Tip: Watch ads for extra Fortune Wheel spins.'
  - "Tip: Heroes can turn the tide of battle \u2014 equip them wisely!"
  - 'Tip: Earn Karma by completing levels to unlock new skills.'
  - 'Tip: Try harder difficulties for greater challenges and rewards!'
  - "Tip: Daily rewards reset every day \u2014 don't miss them!"
  - 'Tip: Position tanky heroes in front of your ranged towers to keep enemies in
    attack range longer.

'
  - 'Tip: Slow and Frost towers synergize perfectly with high-damage single-target
    towers.

'
  - 'Tip: Beam and Splash towers deal immense value against large clusters of swarming
    enemies.

'
  - 'Tip: Check the Wave Info panel (W button) before each wave to inspect incoming
    enemy types and stats!

'
  - 'Tip: Upgrading an existing tower is often more effective than building multiple
    low-level towers.

'
  - 'Tip: Hard and Expert difficulties increase enemy health and damage, but grant
    vastly superior rewards!

'
  - 'Tip: Invest your Crystals and Karma in the Skill Tree to permanently boost all
    towers and heroes.

'
  - "Tip: Deploying ground units from your bottom bar costs resources \u2014 deploy
    them when your line is breached.\n"
  - 'Tip: Barracks soldiers block enemy units, giving your defensive towers extra
    time to attack.

'
